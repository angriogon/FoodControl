{
  "name": "foodcontrol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA para iPhone de control de comidas, bebida y actividad con mascota personalizable.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "barcode-detector": "3.2.3",
    "idb-keyval": "6.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5"
  }
}
